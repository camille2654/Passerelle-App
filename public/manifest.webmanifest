{
  "id": "./",
  "name": "Passerelle · Mon espace scolaire",
  "short_name": "Passerelle",
  "description": "Ta journée prend forme. Cours, devoirs, contrôles et révisions, à votre rythme.",
  "lang": "fr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#fbfcf8",
  "theme_color": "#fbfcf8",
  "icons": [
    {
      "src": "./icons/app-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/app-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            "application/pdf",
            "image/*",
            "text/plain",
            ".doc",
            ".docx",
            ".ppt",
            ".pptx",
            ".xls",
            ".xlsx"
          ]
        }
      ]
    }
  }
}
