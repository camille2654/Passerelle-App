+});
+
+test('account cleanup works without a cached connection and refuses to ignore outages or a known connected profile',async()=>{
+ const calls=[];
+ const client=api.createClient({getAccessToken:async()=>'synthetic-lapsus-token',fetcher:async(url,options)=>{calls.push({url,options});return response({ok:true});}});
