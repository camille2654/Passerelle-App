+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createHandler} from '../functions/api/passerelle/[[path]].js';
+
+const ORIGIN='https://mon-ent.pages.dev',ISSUER='https://repere.84.235.226.127.sslip.io/agenda',AUTH='https://test-project.supabase.co';
+const USER='11111111-1111-4111-8111-111111111111',OTHER='22222222-2222-4222-8222-222222222222';
+const ID='ment-33333333-3333-4333-8333-333333333333';
+const env={PASSERELLE_MANAGED_KEY:'k'.repeat(43),LAPSUS_SUPABASE_URL:AUTH,LAPSUS_SUPABASE_PUBLISHABLE_KEY:'sb_publishable_test_public_key_123456789'};
+const token='synthetic-valid-lapsus-user-session-token-123456';
+function fixture(){
+ let time=Date.now(),user=USER,authStatus=200,upstreamStatus=200,session;
+ const calls=[],logs=[];
+ const handle=createHandler({now:()=>time,logger:entry=>logs.push(entry),fetcher:async(url,options={})=>{
+  calls.push({url:String(url),options});assert.equal(options.redirect,'manual');
+  if(url===AUTH+'/auth/v1/user'&&authStatus===304)return new Response(null,{status:304});
+  if(url===AUTH+'/auth/v1/user')return Response.json({id:user,is_anonymous:false},{status:authStatus});
+  assert.ok(String(url).startsWith(ISSUER+'/api/managed-ent/'),'only fixed upstream may be called');
+  assert.equal(options.headers.Authorization,'Bearer '+env.PASSERELLE_MANAGED_KEY);assert.equal(options.headers['X-Lapsus-User'],user);
+  assert.equal(options.redirect,'manual');assert.ok(!JSON.stringify(options).includes(token));
+  if(upstreamStatus===304)return new Response(null,{status:304});
+  if(upstreamStatus!==200)return Response.json({error:'synthetic-private-upstream-detail'},{status:upstreamStatus});
+  if(String(url).endsWith('/sessions')){session=JSON.parse(options.body);return Response.json({launchURL:ISSUER+'/ent-connect?session='+'s'.repeat(43),sessionId:'must-not-be-returned',expiresAt:time+12*60000,connectionId:ID});}
+  if(String(url).includes('/files/'))return new Response('%PDF-synthetic',{headers:{'Content-Disposition':'attachment; filename=Test.pdf'}});
+  if(String(url).endsWith('/exchange')){const body=JSON.parse(options.body);assert.equal(body.code,'c'.repeat(43));assert.equal(typeof body.codeVerifier,'string');assert.equal(body.codeVerifier.length,43);return Response.json({connectionId:ID,status:'ready',lastSync:time});}
+  return Response.json({connectionId:ID,status:'ready',events:[],lastSync:time});
+ }});
+ async function request(path,{body,method,auth=true,origin=ORIGIN,cookie,environment=env,headers={}}={}){
+  const response=await handle({env:environment,request:new Request(ORIGIN+'/api/passerelle'+path,{method:method||(body===undefined?'GET':'POST'),headers:{...(auth?{Authorization:'Bearer '+token}:{}),...(origin?{Origin:origin}:{}),...(body!==undefined?{'Content-Type':'application/json'}:{}),...(cookie?{Cookie:cookie}:{}),...headers},...(body!==undefined?{body:JSON.stringify(body)}:{})})});
+  return {status:response.status,headers:response.headers,body:response.headers.get('content-type')?.includes('application/octet-stream')?await response.text():await response.json()};
+ }
+ return {request,calls,logs,get session(){return session;},set user(value){user=value;},set time(value){time=value;},get time(){return time;},set authStatus(value){authStatus=value;},set upstreamStatus(value){upstreamStatus=value;}};
+}
+
