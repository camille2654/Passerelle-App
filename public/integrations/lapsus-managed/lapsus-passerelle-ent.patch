+function setManagedConnection(value,reset=false){
+  const next=LapsusPasserelle.metadata(value);
+  const changed=reset||next.connectionId!==managedConnection?.connectionId||next.sourceVersion!==managedConnection?.sourceVersion;
+  managedConnection=next.connectionId?next:null;
