[Unit]
Description=Passerelle public status observations
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/agenda-bridge
ExecStart=/usr/bin/python3 -B /home/ubuntu/apps/agenda-bridge/scripts/status-monitor.py --history /var/lib/passerelle-status/history.json
StateDirectory=passerelle-status
StateDirectoryMode=0755
UMask=0022
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/var/lib/passerelle-status
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=64M
CPUWeight=10
TimeoutStopSec=8

[Install]
WantedBy=multi-user.target
